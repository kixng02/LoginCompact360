@page "/login"
@layout LoginLayout
@rendermode InteractiveServer

@using LC360.Services
@inject IAuthService AuthService
@inject NavigationManager NavManager

<div class="login-page-container">
    <div class="login-panel">
        <h3 class="text-center mb-4">Login</h3>

        @if (_justRegistered)
        {
            <div class="alert alert-success py-2 mb-3">Account created! Please log in.</div>
        }

        <div class="form-group mb-3">
            <label for="email">Email</label>
            <input type="email" class="form-control" id="email"
                   @bind="_email" @bind:event="oninput"
                   placeholder="Enter your email" />
        </div>

        <div class="form-group mb-4">
            <label for="password">Password</label>
            <input type="password" class="form-control" id="password"
                   @bind="_password" @bind:event="oninput"
                   placeholder="Enter your password" />
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger py-2 mb-3">@_errorMessage</div>
        }

        <div class="d-grid">
            <button type="button" class="btn btn-primary"
                    @onclick="HandleLogin"
                    disabled="@(_isBusy || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))">
                @if (_isBusy)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    @:Signing in...
                }
                else
                {
                    @:Sign In
                }
            </button>
        </div>

        <div class="text-center mt-3">
            Don't have an account? <a href="/signup">Sign up</a>
        </div>

        <div class="text-center mt-2">
            <a href="#">Forgot your password?</a>
        </div>
    </div>
</div>

<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
    }

    .login-page-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        width: 100%;
        margin: 0;
        padding: 0;
    }

    .login-panel {
        width: 100%;
        max-width: 400px;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.1);
        background: rgba(255, 255, 255, 0.7);
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(200, 200, 200, 0.5);
        color: #333;
    }

    .login-panel h3 {
        color: #333;
        font-weight: 600;
    }

    .login-panel .form-control {
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(150, 150, 150, 0.5);
        color: #333;
    }

    .login-panel .form-control::placeholder {
        color: #999;
    }

    .login-panel .form-control:focus {
        background: rgba(255, 255, 255, 0.8);
        box-shadow: 0 0 0 0.25rem rgba(100, 100, 100, 0.1);
        border-color: #555;
    }

    .login-panel label {
        font-weight: 500;
        color: #333;
    }

    .login-panel .btn-primary {
        background: #4e73df;
        border: none;
        font-weight: bold;
    }

    .login-panel a {
        color: #4e73df;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "registered")]
    public string? Registered { get; set; }

    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _isBusy;
    private string? _errorMessage;
    private bool _justRegistered;

    protected override void OnInitialized()
    {
        _justRegistered = Registered == "1";
    }

    private async Task HandleLogin()
    {
        _errorMessage = null;
        _isBusy = true;

        try
        {
            var success = await AuthService.LoginAsync(_email, _password);
            if (success)
                NavManager.NavigateTo("/");
            else
                _errorMessage = "Invalid email or password.";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
